
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>카페 메뉴 목록</title>
</head>
<body>
    <h1>카페 메뉴 목록</h1>

    <% menus.forEach(menu => { %>
        <div>
            <h3><%= menu.name %></h3>
            <p>가격: <%= menu.price %>원</p>
            <p>카테고리: <%= menu.category %></p>
        </div>
        <hr>
    <% }) %>

</body>
</html>
