
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>카페 메뉴 관리</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }

        h1, h2 {
            margin: 10px 0;
        }

        table {
            border-collapse: collapse;
            width: 100%;
            text-align: center;
        }

        th, td {
            border: 1px solid black;
            padding: 4px 8px;
        }

        form {
            margin: 8px 0;
        }
    </style>
</head>
<body>
    <h1>카페 메뉴 관리</h1>

    <h2>메뉴 검색</h2>
    <form action="/menus/search" method="GET">
        <input type="text" name="keyword"
               placeholder="검색할 메뉴 이름"
               value="<%= keyword %>">
        <button type="submit">검색</button>
        <a href="/menus">전체 메뉴 보기</a>
    </form>

    <h2>메뉴 추가</h2>
    <form action="/menus" method="POST">
        <input type="text" name="name"
               placeholder="메뉴 이름" required>
        <input type="number" name="price"
               placeholder="가격" min="0" required>

        <select name="category">
            <option value="커피">커피</option>
            <option value="티">티</option>
            <option value="디저트">디저트</option>
        </select>

        <button type="submit">추가</button>
    </form>

    <h2>전체 메뉴 목록</h2>

    <table>
        <tr>
            <th>번호</th>
            <th>메뉴</th>
            <th>가격</th>
            <th>종류</th>
            <th>관리</th>
        </tr>

        <% menus.forEach(menu => { %>
        <tr>
            <td><%= menu.id %></td>
            <td><%= menu.name %></td>
            <td><%= menu.price %>원</td>
            <td><%= menu.category %></td>
            <td>
                <a href="/menus/<%= menu.id %>/edit">수정</a>

                <form action="/menus/<%= menu.id %>/delete"
                      method="POST" style="display:inline;">
                    <button type="submit"
                        onclick="return confirm('정말 삭제하시겠습니까?')">
                        삭제
                    </button>
                </form>
            </td>
        </tr>
        <% }) %>
    </table>
</body>
</html>
